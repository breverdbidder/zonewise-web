{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zonewise-web-production",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // LAUNCH-A (#20035): "/" is a prerendered static file, so by default
    // Cloudflare serves it directly and never invokes the Worker — Next's
    // own middleware.ts and next.config.mjs headers() (which already declare
    // HSTS/nosniff/Referrer-Policy/X-Frame-Options) never run. Verified live
    // 2026-09-05: curl -sI https://zonewise.ai/ returned none of them.
    // Scoping run_worker_first to just "/" (not a blanket true) sends only
    // the homepage through the full OpenNext/Next pipeline — every other
    // static asset keeps the zero-Worker-invocation cost path.
    "run_worker_first": ["/"]
  },
  // Plan probe result 2026-09-05 12:22 UTC (sibling #20025, run 33965846032): the account is on
  // Workers FREE — Cloudflare rejects `limits.cpu_ms` (code 100328). Removed to restore service:
  // Vercel returned 402 DEPLOYMENT_DISABLED on zonewise.ai the same minute. Workers Paid ($5/mo)
  // is Ariel's decision, surfaced in #20026.
  // R2 is NOT enabled on the account (API 10042 "Please enable R2 through the Cloudflare
  // Dashboard"), so the R2 incremental-cache binding is removed; ISR routes render dynamically
  // until R2 is enabled (then restore r2IncrementalCache in open-next.config.ts + this binding).
  //
  // Cutover 2026-09-05 (chat, DNS-scoped token): the Vercel A/CNAME records on zonewise.ai and www
  // were replaced by proxied placeholder A records (192.0.2.1) so these zone routes receive the
  // traffic — the same proxied-record + Worker-route pattern biddeed.ai and mcp.biddeed.ai use.
  // mcp.zonewise.ai is deliberately NOT bound: the MCP route only exists in unmerged PR #102.
  // Rollback: cli-anything-biddeed docs/spec/20026-rollback.md.
  "routes": [
    { "pattern": "zonewise.ai/*", "zone_name": "zonewise.ai" },
    { "pattern": "www.zonewise.ai/*", "zone_name": "zonewise.ai" }
  ],
  "observability": {
    "enabled": true
  }
}
