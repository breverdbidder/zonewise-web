{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/app", "destination": "https://zonewise-desktop-viewer.vercel.app/" },
    { "source": "/app/:path*", "destination": "https://zonewise-desktop-viewer.vercel.app/:path*" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-ZoneWise-Version", "value": "v4-landing" }
      ]
    }
  ]
}
