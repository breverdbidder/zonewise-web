{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "rewrites": [
    {
      "source": "/app",
      "destination": "https://zonewise-desktop-viewer.vercel.app/"
    },
    {
      "source": "/app/:path*",
      "destination": "https://zonewise-desktop-viewer.vercel.app/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://zonewise-desktop-viewer.vercel.app/assets/:path*"
    }
  ],
  "headers": [
    {
      "source": "/app/(.*)",
      "headers": [
        { "key": "X-Upstream-Source", "value": "craft-agents-oss" },
        { "key": "X-ZoneWise-Version", "value": "auto-synced" }
      ]
    }
  ]
}
