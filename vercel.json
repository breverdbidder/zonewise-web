{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --legacy-peer-deps",
  "rewrites": [
    { "source": "/competitors", "destination": "/competitors.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-ZoneWise-Version", "value": "v4-nextjs-restored" }
      ]
    }
  ]
}
