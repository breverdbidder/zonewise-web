# Security headers for responses served directly by Workers Static Assets:
# public/index.html (/), public/competitors.html, public/video.html, /_next/static/*, manifest, robots.
# These responses never pass through middleware.ts or next.config headers(), so without this file
# they went out with no CSP / HSTS / X-Frame-Options / nosniff (OWASP ZAP baseline, 2026-09-23, D13).
# Worker-generated (Next.js) responses are unaffected: Cloudflare applies _headers to static assets only.
#
# IMPORTANT: the script hashes below are tied to the exact bytes of the inline <script> in
# public/index.html and public/video.html (and video's onclick="startVideo()").
# If you edit one of those scripts, recompute its sha256 or the browser will block it.

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), payment=(self "https://js.stripe.com"), camera=(), microphone=(self), interest-cohort=()

/
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com 'sha256-GzDfCkijWLQ1rn0e3iUp5EOotzupq7A1ieOVBAuQJHM='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/index.html
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com 'sha256-GzDfCkijWLQ1rn0e3iUp5EOotzupq7A1ieOVBAuQJHM='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/competitors
